# OpenRouter API Key (get one at https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM Model Name (default: meta-llama/llama-3.3-70b-instruct)
MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
# Optional database path (default: spec2assert.db)
DB_PATH=spec2assert.db
# Offline Mock Mode (set to true for development without API credits)
MOCK_LLM=false
